# Meta App credentials: developers.facebook.com -> Your App -> Settings -> Basic
FB_APP_ID=your_app_id_here
FB_APP_SECRET=your_app_secret_here

GRAPH_API_VERSION=v21.0

# Must exactly match a "Valid OAuth Redirect URI" in your Meta App settings.
# Local:  http://localhost:5000/auth/facebook/callback
# Vercel: https://your-project.vercel.app/auth/facebook/callback
FB_REDIRECT_URI=http://localhost:5000/auth/facebook/callback

PORT=5000

# NEVER commit a real .env, never paste real tokens anywhere shared.
